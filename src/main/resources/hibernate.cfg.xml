<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.dialect">${hibernate.dialect}</property>

        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">false</property>

        <property name="hibernate.hbm2ddl.auto">update</property>

        <mapping class="com.arquita.legacy.dominio.Contribuyente"/>
        <mapping class="com.arquita.legacy.dominio.Factura"/>
        <mapping class="com.arquita.legacy.dominio.DetalleFactura"/>
        <mapping class="com.arquita.legacy.dominio.Pago"/>
        <mapping class="com.arquita.legacy.dominio.NotaCredito"/>
    </session-factory>
</hibernate-configuration>
