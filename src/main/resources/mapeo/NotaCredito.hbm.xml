<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="com.arquita.legacy.dominio">

    <class name="NotaCredito" table="NOTA_CREDITO">

        <id name="id" column="ID" type="java.lang.Long">
            <generator class="sequence">
                <param name="sequence">HIBERNATE_SEQUENCE</param>
            </generator>
        </id>

        <property name="facturaOriginalId" column="FACTURA_ORIGINAL_ID" type="java.lang.Long" not-null="true"/>
        <property name="numero" column="NUMERO" type="java.lang.Long"/>
        <property name="puntoVenta" column="PUNTO_VENTA" type="java.lang.Integer"/>
        <property name="fecha" column="FECHA" type="timestamp"/>
        <property name="motivo" column="MOTIVO" type="string"/>
        <property name="importe" column="IMPORTE" type="double"/>
        <property name="cae" column="CAE" type="string"/>
        <property name="caeVencimiento" column="CAE_VENCIMIENTO" type="timestamp"/>

    </class>

</hibernate-mapping>
