<?xml version="1.0" encoding="UTF-8"?>
<!--
    Unidad de persistencia armada a la vieja usanza: sin clases anotadas,
    el mapeo entidad/tabla vive en los *.hbm.xml de src/main/resources/mapeo/.
    La fabrica se construye a mano en com.arquita.legacy.persistencia.HibernateUtil
    (Persistence.createEntityManagerFactory("arquitaPU")): no hay contenedor
    ni Spring que la administre.
-->
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
             http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd"
             version="2.0">

    <persistence-unit name="arquitaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.ejb.HibernatePersistence</provider>

        <mapping-file>mapeo/Contribuyente.hbm.xml</mapping-file>
        <mapping-file>mapeo/Factura.hbm.xml</mapping-file>
        <mapping-file>mapeo/DetalleFactura.hbm.xml</mapping-file>
        <mapping-file>mapeo/Pago.hbm.xml</mapping-file>
        <mapping-file>mapeo/NotaCredito.hbm.xml</mapping-file>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.dialect" value="${hibernate.dialect}"/>

            <!-- Sin pool externo (no hay mas commons-dbcp): Hibernate abre las
                 conexiones el mismo con su DriverManagerConnectionProvider interno,
                 que la propia documentacion de Hibernate marca como
                 "not intended for use in production systems". -->
            <property name="hibernate.connection.driver_class" value="${jdbc.driverClassName}"/>
            <property name="hibernate.connection.url" value="${jdbc.url}"/>
            <property name="hibernate.connection.username" value="${jdbc.username}"/>
            <property name="hibernate.connection.password" value="${jdbc.password}"/>
            <property name="hibernate.connection.pool_size" value="5"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="false"/>

            <property name="hibernate.hbm2ddl.auto" value="update"/>
        </properties>
    </persistence-unit>

</persistence>
