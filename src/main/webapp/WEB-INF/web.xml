<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">

    <display-name>Arquita Legacy Monolito de Facturacion</display-name>

    <listener>
        <listener-class>com.arquita.legacy.arranque.ArranqueListener</listener-class>
    </listener>

    <servlet>
        <servlet-name>contribuyentes</servlet-name>
        <servlet-class>com.arquita.legacy.web.ContribuyenteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>contribuyentes</servlet-name>
        <url-pattern>/api/contribuyentes/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>facturas</servlet-name>
        <servlet-class>com.arquita.legacy.web.FacturaServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>facturas</servlet-name>
        <url-pattern>/api/facturas/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>pagos</servlet-name>
        <servlet-class>com.arquita.legacy.web.PagoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>pagos</servlet-name>
        <url-pattern>/api/pagos/*</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>WEB-INF/jsp/index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
